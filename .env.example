# ── Supabase (required for login + publish spots) ──
# Dashboard → Authentication → Providers → enable "Anonymous Sign-Ins" for guest spot posting
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Service role — server/seed + dev admin delete. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dev spot cleanup — comma-separated emails that see "Delete invalid spot" on curated pages
ADMIN_EMAILS=

# ── Google Maps (in-app /map page — optional; falls back to OpenStreetMap) ──
# Google Cloud → enable "Maps JavaScript API" + "Geocoding API" + "Places API" (spot seeding)
# Restrict key to your domains (jompancing.my, *.vercel.app, localhost)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only key for Geocoding + Places API (reverse-geocode, npm run seed:spots)
GOOGLE_MAPS_API_KEY=
# Optional Map ID (Cloud Console → Map Management) for Advanced Markers
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Production site URL (Vercel + custom domain) ──
# Used for metadata & auth redirects. Set in Vercel → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://jompancing.my

# ── Vercel deploy checklist ──
# 1. Push repo to GitHub
# 2. vercel.com → Import project → add env vars above
# 3. Supabase → Authentication → URL Configuration:
#    Site URL: https://jompancing.my/ms
#    Redirect URLs:
#      https://jompancing.my/**
#      https://www.jompancing.my/**
#      https://*.vercel.app/**
#      http://localhost:3000/**
#    Providers → Email: DISABLE "Confirm email" (no email verify)
#    Providers → Google: enable, add Client ID + Secret from Google Cloud Console
#      Google OAuth redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 3b. Run supabase/migrations/003_google_profile.sql in SQL Editor (Google avatar/name)
# 4. Supabase → SQL Editor → run supabase/migrations/002_activities.sql
# 4b. Run supabase/migrations/004_forum_comments.sql (forum + shared comments)
# 4c. Run supabase/migrations/005_marketplace.sql (gear listings + listing-photos bucket)
# 4d. Run supabase/migrations/006_curated_google_spots.sql then: npm run seed:spots
# 5. Supabase → Authentication → Emails:
#    - Templates: paste HTML from supabase/email-templates/*.html
#    - Subject: "Sahkan e-mel anda — Jompancing" (confirm signup)
#    - SMTP (production): Sender name "Jompancing", e.g. no-reply@jompancing.my via Resend/SendGrid
# 4. Exabytes DNS: CNAME @ → cname.vercel-dns.com (or A record per Vercel)
# 5. Vercel → Domains → add jompancing.my
